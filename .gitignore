# ROMs and disc images live in roms/; never commit them. The patterns below catch any left elsewhere
# (README.md and CHANGELOG.md are the only .md files in the root)
roms/
*.sfc
*.smc
*.32x
*.j64
*.gb
*.gg
*.chd
*.z64
*.iso
*.bin
/*.md
!/README.md
!/CHANGELOG.md
__pycache__/
.claude/
*.zip

# emulator test output
tools/tests/_run.lua
tools/tests/_s.lua
tools/tests/_ads.lua
tools/tests/log.txt
tools/tests/*.png
tools/tests/*.ram
tools/tests/nvram/
tools/tests/cfg/
